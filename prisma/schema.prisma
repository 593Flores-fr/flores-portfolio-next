generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String    @unique
  password  String?
  image     String?
  discordId String?   @unique
  role      String    @default("member")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  projects  Project[]
  reviews   Review[]
  invoices  Invoice[]
  reports   Report[]
}

// "open"     = signalement soumis, en attente de traitement
// "seen"     = vu par admin
// "resolved" = résolu
// "closed"   = fermé sans action
model Report {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("bug") // "bug" | "suggestion" | "autre"
  description String
  url         String?
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invoice {
  id            String    @id @default(cuid())
  number        String    @unique
  type          String    @default("devis") // "devis" | "facture"
  status        String    @default("draft") // "draft" | "sent" | "paid" | "cancelled"
  clientName    String    @default("")
  clientEmail   String    @default("")
  clientAddress String    @default("")
  items         Json      @default("[]")
  taxRate       Float     @default(0)
  notes         String    @default("")
  issuedAt      DateTime  @default(now())
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  fromAdmin Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// "pending"  = devis soumis, en attente de réponse admin
// "accepted" = devis accepté, en attente de paiement
// "active"   = paiement confirmé, projet en cours (kanban visible)
// "completed"= projet livré
// "rejected" = devis refusé
model Project {
  id             String          @id @default(cuid())
  title          String
  description    String?
  type           String
  budget         String?
  deadline       String?
  references     String?
  contact        String?
  status         String          @default("pending")
  paid           Boolean         @default(false)
  adminNotes     String?
  kanbanNotes    String?
  kanbanVisible  Boolean         @default(false)
  projectSummary String?
  phone          String?
  callSlots      String?
  briefFile      String?
  briefFileName  String?
  signedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns        KanbanColumn[]
  review         Review?
  deliverables   Deliverable[]
  moodboard      MoodboardItem[]

  @@index([userId])
}

// Compteur générique de rate limiting — key = "route:identifiant" (ip ou email)
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  page      String
  createdAt DateTime @default(now())

  @@index([page])
  @@index([createdAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  provider  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PortfolioProject {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  tag             String   @default("")
  description     String   @default("")
  imageSrc        String   @default("")
  logoSrc         String   @default("")
  sectionId       String?
  section         PortfolioSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  year            String   @default("")
  client          String   @default("")
  fullDescription String   @default("")
  challenge       String   @default("")
  images          Json     @default("[]")
  mockupImages    Json     @default("[]")
  blocks          Json     @default("[]")
  tools           Json     @default("[]")
  externalLink    String?
  discordUrl      String?
  accentColor     String   @default("")
  order           Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sectionId])
}

model PortfolioSection {
  id        String             @id @default(cuid())
  name      String             @unique
  color     String             @default("#5c5cf5")
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  projects  PortfolioProject[]
}

model KanbanColumn {
  id        String       @id @default(cuid())
  title     String
  order     Int
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     KanbanTask[]

  @@index([projectId])
}

model KanbanTask {
  id          String       @id @default(cuid())
  title       String
  description String?
  category    String?
  priority    String       @default("moyen")
  order       Int
  done        Boolean      @default(false)
  createdAt   DateTime     @default(now())
  columnId    String
  column      KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
}

// "idle"      = pas encore demandé
// "requested" = admin a demandé un avis au client
// "submitted" = client a rédigé son avis, en attente de validation admin
// "approved"  = visible sur le site
// "hidden"    = masqué par admin
model Review {
  id          String    @id @default(cuid())
  content     String?
  rating      Int       @default(5)
  status      String    @default("idle")
  requestedAt DateTime?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String    @unique
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SiteContent {
  id        String   @id @default(cuid())
  section   String   @unique
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// status: "pending" | "approved" | "rejected"
model Deliverable {
  id         String    @id @default(cuid())
  fileName   String
  fileUrl    String
  fileType   String    @default("file") // "image" | "pdf" | "file"
  version    Int       @default(1)
  notes      String?
  status     String    @default("pending")
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model MoodboardItem {
  id        String   @id @default(cuid())
  imageUrl  String
  note      String?
  fromAdmin Boolean  @default(true)
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
